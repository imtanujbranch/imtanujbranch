import React, { useState, useCallback, useMemo, useEffect, useRef } from 'react';
import { Button, Select, SelectItem, Input, Card, CardHeader, CardTitle, CardContent, Label, AlertDialog, MetricCard } from './components/ui';

// --- Icons ---
const SunIcon = ({ className }: { className?: string }) => (
  <svg className={className} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
);

const MoonIcon = ({ className }: { className?: string }) => (
  <svg className={className} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
);

// --- Types ---
type Theme = 'light' | 'dark';
type MemoryManagementType = 'paging' | 'segmentation' | 'dynamic_allocation';
type DynamicStrategy = 'first_fit' | 'best_fit' | 'worst_fit';
type BlockStatus = 'free' | 'allocated';

interface Block {
  start: number;
  size: number;
  status: BlockStatus;
  processId: number | null;
}

interface Process {
  id: number;
  size: number;
  allocatedBlockIndex: number | null;
}

interface AlertDialogProps {
  title: string;
  description: string;
  open: boolean;
  onClose: () => void;
  theme: Theme;
}

interface MetricCardProps {
  title: string;
  value: string;
  subValue?: string;
  baseBgColor: 'blue' | 'green' | 'yellow' | 'red' | 'indigo';
  theme: Theme;
}

// --- Constants ---
const MEMORY_MANAGEMENT_TYPES: Record<string, MemoryManagementType> = {
  PAGING: 'paging',
  SEGMENTATION: 'segmentation',
  DYNAMIC_ALLOCATION: 'dynamic_allocation',
};

const DYNAMIC_STRATEGIES: Record<string, DynamicStrategy> = {
  FIRST_FIT: 'first_fit',
  BEST_FIT: 'best_fit',
  WORST_FIT: 'worst_fit',
};

const BLOCK_STATUS: Record<string, BlockStatus> = {
  FREE: 'free',
  ALLOCATED: 'allocated',
};

const ANIMATION_DELAY_MS = 400;
const CSS_TRANSITION_DURATION = '0.3s';

// --- Helper Function for Delay ---
const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));

// --- Helper Function to Generate Random Initial Layout ---
const generateInitialLayout = (
  totalSize: number,
  minBlockSize = 32,
  maxBlockSizeFraction = 0.2,
  allocationProbability = 0.6
): { initialBlocks: Block[]; initialProcesses: Process[]; nextId: number } => {
  // ... [Implementation remains the same] ...
  const initialBlocks: Block[] = [];
  const initialProcesses: Process[] = [];
  let currentStart = 0;
  let currentProcessId = 1;
  const actualMaxBlockSize = Math.max(minBlockSize, Math.floor(totalSize * maxBlockSizeFraction));

  while (currentStart < totalSize) {
    const remainingSize = totalSize - currentStart;
    let blockSize = Math.floor(Math.random() * (actualMaxBlockSize - minBlockSize + 1)) + minBlockSize;
    blockSize = Math.min(blockSize, remainingSize);

    if (currentStart + blockSize >= totalSize) {
      blockSize = remainingSize;
    }
    if (remainingSize < minBlockSize && remainingSize > 0 && initialBlocks.length > 0 && initialBlocks[initialBlocks.length - 1].status === BLOCK_STATUS.FREE) {
      initialBlocks[initialBlocks.length - 1].size += remainingSize;
      currentStart += remainingSize;
      break;
    }
    if (blockSize === 0) break;

    let status: BlockStatus;
    let processId: number | null = null;

    if (Math.random() < allocationProbability) {
      status = BLOCK_STATUS.ALLOCATED;
      processId = currentProcessId;
      initialProcesses.push({
        id: currentProcessId,
        size: blockSize,
        allocatedBlockIndex: initialBlocks.length
      });
      currentProcessId++;
    } else {
      status = BLOCK_STATUS.FREE;
    }

    initialBlocks.push({
      start: currentStart,
      size: blockSize,
      status,
      processId,
    });

    currentStart += blockSize;
  }

  let merged = true;
  let finalBlocks = [...initialBlocks];
  while (merged) {
    merged = false;
    const mergedBlocksIteration: Block[] = [];
    let i = 0;
    while (i < finalBlocks.length) {
      let currentBlock = finalBlocks[i];
      if (i + 1 < finalBlocks.length && currentBlock.status === BLOCK_STATUS.FREE && finalBlocks[i + 1].status === BLOCK_STATUS.FREE) {
        const nextBlock = finalBlocks[i + 1];
        const newMergedBlock = { ...currentBlock, size: currentBlock.size + nextBlock.size };
        mergedBlocksIteration.push(newMergedBlock);
        i += 2;
        merged = true;
      } else {
        mergedBlocksIteration.push(currentBlock);
        i += 1;
      }
    }
    finalBlocks = mergedBlocksIteration;
  }

  const finalProcesses = initialProcesses
    .map(proc => {
      const blockIndex = finalBlocks.findIndex(b => b.processId === proc.id);
      return { ...proc, allocatedBlockIndex: blockIndex !== -1 ? blockIndex : null };
    })
    .filter(proc => proc.allocatedBlockIndex !== null);

  return { initialBlocks: finalBlocks, initialProcesses: finalProcesses, nextId: currentProcessId };
};

// --- Memory Visualization Component ---
const MemoryVisualization = React.memo(({ 
  blocks, 
  totalSize, 
  examinedIndex, 
  candidateIndices, 
  currentTheme 
}: { 
  blocks: Block[]; 
  totalSize: number; 
  examinedIndex: number | null; 
  candidateIndices: number[]; 
  currentTheme: Theme;
}) => {
  const isDark = currentTheme === 'dark';

  // Define colors based on theme
  const svgBackgroundColor = isDark ? '#374151' : '#e2e8f0';
  const svgBackgroundStroke = isDark ? '#4b5563' : '#cbd5e1';

  const allocatedFillColor = isDark ? '#3b82f6' : '#3b82f6';
  const allocatedStrokeColor = isDark ? '#2563eb' : '#2563eb';
  const allocatedPatternStroke = isDark ? 'rgba(200,200,255,0.2)' : 'rgba(255,255,255,0.2)';

  const freeFillColor = isDark ? '#16a34a' : '#22c55e';
  const freeStrokeColor = isDark ? '#15803d' : '#16a34a';

  const allocatedTextColor = isDark ? 'white' : 'white';
  const freeTextColor = isDark ? '#d1d5db' : 'black';

  const examinedStroke = isDark ? "#fcd34d" : "#f59e0b";
  const candidateStroke = isDark ? "#fb923c" : "#f97316";

  return (
    <svg width="100%" height="100%" viewBox={`0 0 ${totalSize} 60`} preserveAspectRatio="xMidYMid meet">
      <defs>
        <pattern id="allocatedPattern" patternUnits="userSpaceOnUse" width="6" height="6">
          <path d="M-1,1 l2,-2 M0,6 l6,-6 M5,7 l2,-2" style={{ stroke: allocatedPatternStroke, strokeWidth: 0.5 }} />
        </pattern>
      </defs>
      <rect x="0" y="0" width={totalSize} height="60" fill={svgBackgroundColor} stroke={svgBackgroundStroke} strokeWidth="0.5" />

      {blocks.map((block, index) => {
        const blockWidth = block.size;
        const xPos = block.start;
        const isAllocated = block.status === BLOCK_STATUS.ALLOCATED;

        const color = isAllocated ? allocatedFillColor : freeFillColor;
        const pattern = isAllocated ? 'url(#allocatedPattern)' : 'none';
        const currentTextColor = isAllocated ? allocatedTextColor : freeTextColor;
        const text = block.processId ? `P${block.processId} (${block.size})` : `Free (${block.size})`;
        const showText = blockWidth > Math.max(30, totalSize * 0.03);

        let strokeColor = isAllocated ? allocatedStrokeColor : freeStrokeColor;
        let strokeWidth = 0.5;
        let gTransform = '';
        const transformOrigin = `${xPos + blockWidth / 2} ${30}`;
        let extraRect = null;

        if (index === examinedIndex) {
          strokeColor = examinedStroke;
          strokeWidth = 2.5;
          gTransform = 'scale(1.03)';
        } else if (candidateIndices.includes(index)) {
          extraRect = (
            <rect
              x={xPos}
              y="0"
              width={blockWidth}
              height="60"
              fill="none"
              stroke={candidateStroke}
              strokeWidth="2"
              strokeDasharray="5 3"
              style={{ transition: `all ${CSS_TRANSITION_DURATION} ease-in-out` }}
            />
          );
        }

        const gTagTransitionStyle = {
          transition: `x ${CSS_TRANSITION_DURATION} ease-in-out, width ${CSS_TRANSITION_DURATION} ease-in-out, transform ${CSS_TRANSITION_DURATION} ease-in-out`,
          transform: gTransform,
          transformOrigin: transformOrigin,
        };
        const mainRectStyle = {
          transition: `fill ${CSS_TRANSITION_DURATION} ease-in-out, stroke ${CSS_TRANSITION_DURATION} ease-in-out, stroke-width ${CSS_TRANSITION_DURATION} ease-in-out, x ${CSS_TRANSITION_DURATION} ease-in-out, width ${CSS_TRANSITION_DURATION} ease-in-out`,
        };
        const patternRectStyle = {
          pointerEvents: 'none' as const,
          transition: `x ${CSS_TRANSITION_DURATION} ease-in-out, width ${CSS_TRANSITION_DURATION} ease-in-out, fill ${CSS_TRANSITION_DURATION} ease-in-out`,
        };
        const textElementStyle = {
          pointerEvents: 'none' as const,
          userSelect: 'none' as const,
          transition: `x ${CSS_TRANSITION_DURATION} ease-in-out, fill ${CSS_TRANSITION_DURATION} ease-in-out`,
        };

        return (
          <g key={`${block.start}-${block.size}-${block.processId || 'free'}`} style={gTagTransitionStyle}>
            <rect
              x={xPos}
              y="0"
              width={blockWidth}
              height="60"
              fill={color}
              stroke={strokeColor}
              strokeWidth={strokeWidth}
              style={mainRectStyle}
            />
            <rect x={xPos} y="0" width={blockWidth} height="60" fill={pattern} style={patternRectStyle} />
            {extraRect}
            {showText && (
              <text
                x={xPos + blockWidth / 2}
                y="35"
                fill={currentTextColor}
                textAnchor="middle"
                fontSize="10"
                fontWeight="medium"
                style={textElementStyle}
              >
                {text}
              </text>
            )}
            <title>{`Block ${index}: Status=${block.status}, Start=${block.start}, Size=${block.size}${
              block.processId ? `, ProcessID=P${block.processId}` : ''
            }`}</title>
          </g>
        );
      })}
    </svg>
  );
});

// --- Main Application Component ---
function App() {
  // --- State Variables ---
  const [theme, setTheme] = useState<Theme>('light');
  const [memorySize, setMemorySize] = useState(1024);
  const [selectedTechnique, setSelectedTechnique] = useState<MemoryManagementType>(MEMORY_MANAGEMENT_TYPES.DYNAMIC_ALLOCATION);
  const [dynamicStrategy, setDynamicStrategy] = useState<DynamicStrategy>(DYNAMIC_STRATEGIES.FIRST_FIT);
  const [processes, setProcesses] = useState<Process[]>([]);
  const [memoryBlocks, setMemoryBlocks] = useState<Block[]>([]);
  const [nextProcessId, setNextProcessId] = useState(1);
  const [newProcessSize, setNewProcessSize] = useState('');
  const [logMessages, setLogMessages] = useState<string[]>(['Simulator initialized.']);
  const [alertDialog, setAlertDialog] = useState({ open: false, title: '', description: '' });
  const [isAnimating, setIsAnimating] = useState(false);
  const [examinedBlockIndex, setExaminedBlockIndex] = useState<number | null>(null);
  const [candidateBlockIndices, setCandidateBlockIndices] = useState<number[]>([]);

  const memoryBlocksRef = useRef(memoryBlocks);
  useEffect(() => {
    memoryBlocksRef.current = memoryBlocks;
  }, [memoryBlocks]);

  // --- Theme Management ---
  useEffect(() => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme && (savedTheme === 'light' || savedTheme === 'dark')) {
      setTheme(savedTheme as Theme);
    } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      setTheme('dark');
    }
  }, []);

  useEffect(() => {
    const root = window.document.documentElement;
    if (theme === 'dark') {
      root.classList.add('dark');
    } else {
      root.classList.remove('dark');
    }
    localStorage.setItem('theme', theme);
  }, [theme]);

  const toggleTheme = () => {
    setTheme(prev => (prev === 'light' ? 'dark' : 'light'));
  };

  // --- Utility Functions ---
  const showAlert = (title: string, description: string) => {
    setAlertDialog({ open: true, title, description });
  };

  const closeAlert = () => {
    setAlertDialog({ open: false, title: '', description: '' });
  };

  // --- Logging ---
  const log = useCallback((message: string) => {
    setLogMessages(prev => [`[${new Date().toLocaleTimeString()}] ${message}`, ...prev].slice(0, 100));
  }, []);

  // --- Initialization and Reset ---
  const resetSimulation = useCallback((newSize: number) => {
    setIsAnimating(false);
    setExaminedBlockIndex(null);
    setCandidateBlockIndices([]);
    const { initialBlocks, initialProcesses, nextId } = generateInitialLayout(newSize);
    setMemoryBlocks(initialBlocks);
    setProcesses(initialProcesses);
    setNextProcessId(nextId);
    setNewProcessSize('');
    log(`Simulation reset. Memory size: ${newSize}. Strategy: ${dynamicStrategy || 'N/A'}. Initialized with ${initialProcesses.length} random processes.`);
  }, [log, dynamicStrategy]);

  useEffect(() => {
    resetSimulation(memorySize);
  }, [memorySize, resetSimulation]);

  // --- Core Allocation/Deallocation Logic ---
  const finalizeAllocation = (blocksToUpdate: Block[], blockIndex: number, processToAllocate: Process) => {
    const currentBlocks = [...blocksToUpdate];
    const block = currentBlocks[blockIndex];
    const remainingSize = block.size - processToAllocate.size;
    const updatedProcess = { ...processToAllocate, allocatedBlockIndex: blockIndex };

    if (remainingSize > 0) {
      currentBlocks[blockIndex] = { ...block, size: processToAllocate.size, status: BLOCK_STATUS.ALLOCATED, processId: updatedProcess.id };
      currentBlocks.splice(blockIndex + 1, 0, {
        start: block.start + processToAllocate.size,
        size: remainingSize,
        status: BLOCK_STATUS.FREE,
        processId: null
      });
      for (let i = blockIndex + 2; i < currentBlocks.length; i++) {
        currentBlocks[i].start = currentBlocks[i - 1].start + currentBlocks[i - 1].size;
      }
      setProcesses(prevProcs =>
        prevProcs.map(p => {
          if (p.id === updatedProcess.id) return updatedProcess;
          if (p.allocatedBlockIndex !== null && p.allocatedBlockIndex > blockIndex) {
            return { ...p, allocatedBlockIndex: p.allocatedBlockIndex + 1 };
          }
          return p;
        }).concat(prevProcs.find(p => p.id === updatedProcess.id) ? [] : [updatedProcess])
      );
      log(`Split block ${blockIndex}. Allocated P${updatedProcess.id} (size ${processToAllocate.size}). New free block at ${blockIndex + 1} (size ${remainingSize}).`);
    } else {
      currentBlocks[blockIndex] = { ...block, status: BLOCK_STATUS.ALLOCATED, processId: updatedProcess.id };
      setProcesses(prevProcs =>
        prevProcs.map(p => p.id === updatedProcess.id ? updatedProcess : p)
          .concat(prevProcs.find(p => p.id === updatedProcess.id) ? [] : [updatedProcess])
      );
      log(`Allocated entire block ${blockIndex} to P${updatedProcess.id}.`);
    }
    setMemoryBlocks(currentBlocks);
    return updatedProcess;
  };

  const allocateFirstFit = useCallback(async (process: Process) => {
    const currentBlocks = [...memoryBlocksRef.current];
    for (let i = 0; i < currentBlocks.length; i++) {
      setExaminedBlockIndex(i);
      log(`First-Fit: Examining block ${i} (Size: ${currentBlocks[i].size}, Status: ${currentBlocks[i].status})`);
      await delay(ANIMATION_DELAY_MS);
      if (currentBlocks[i].status === BLOCK_STATUS.FREE && currentBlocks[i].size >= process.size) {
        log(`First-Fit: Found suitable block at index ${i}. Allocating...`);
        finalizeAllocation(currentBlocks, i, process);
        setExaminedBlockIndex(null);
        return true;
      }
    }
    log(`First-Fit: Allocation failed for P${process.id} (Size: ${process.size}). No suitable free block.`);
    setExaminedBlockIndex(null);
    return false;
  }, [log]);

  const allocateBestFit = useCallback(async (process: Process) => {
    const currentBlocks = [...memoryBlocksRef.current];
    let bestFitIndex = -1;
    let minSuitableSize = Infinity;
    let candidates: number[] = [];
    for (let i = 0; i < currentBlocks.length; i++) {
      setExaminedBlockIndex(i);
      log(`Best-Fit: Examining block ${i} (Size: ${currentBlocks[i].size}, Status: ${currentBlocks[i].status})`);
      await delay(ANIMATION_DELAY_MS / 2);
      const block = currentBlocks[i];
      if (block.status === BLOCK_STATUS.FREE && block.size >= process.size) {
        candidates.push(i);
        setCandidateBlockIndices([...candidates]);
        if (block.size < minSuitableSize) {
          minSuitableSize = block.size;
          bestFitIndex = i;
        }
      }
    }
    log(`Best-Fit: Candidates: [${candidates.join(', ')}]. Chosen best index: ${bestFitIndex !== -1 ? bestFitIndex : 'None'}`);
    setExaminedBlockIndex(null);
    await delay(ANIMATION_DELAY_MS);
    if (bestFitIndex !== -1) {
      setExaminedBlockIndex(bestFitIndex);
      log(`Best-Fit: Allocating in best block ${bestFitIndex}.`);
      await delay(ANIMATION_DELAY_MS / 2);
      finalizeAllocation(currentBlocks, bestFitIndex, process);
      setExaminedBlockIndex(null);
      setCandidateBlockIndices([]);
      return true;
    }
    log(`Best-Fit: Allocation failed for P${process.id} (Size: ${process.size}). No suitable free block.`);
    setCandidateBlockIndices([]);
    return false;
  }, [log]);

  const allocateWorstFit = useCallback(async (process: Process) => {
    const currentBlocks = [...memoryBlocksRef.current];
    let worstFitIndex = -1;
    let maxSuitableSize = -1;
    let candidates: number[] = [];
    for (let i = 0; i < currentBlocks.length; i++) {
      setExaminedBlockIndex(i);
      log(`Worst-Fit: Examining block ${i} (Size: ${currentBlocks[i].size}, Status: ${currentBlocks[i].status})`);
      await delay(ANIMATION_DELAY_MS / 2);
      const block = currentBlocks[i];
      if (block.status === BLOCK_STATUS.FREE && block.size >= process.size) {
        candidates.push(i);
        setCandidateBlockIndices([...candidates]);
        if (block.size > maxSuitableSize) {
          maxSuitableSize = block.size;
          worstFitIndex = i;
        }
      }
    }
    log(`Worst-Fit: Candidates: [${candidates.join(', ')}]. Chosen worst index: ${worstFitIndex !== -1 ? worstFitIndex : 'None'}`);
    setExaminedBlockIndex(null);
    await delay(ANIMATION_DELAY_MS);
    if (worstFitIndex !== -1) {
      setExaminedBlockIndex(worstFitIndex);
      log(`Worst-Fit: Allocating in worst block ${worstFitIndex}.`);
      await delay(ANIMATION_DELAY_MS / 2);
      finalizeAllocation(currentBlocks, worstFitIndex, process);
      setExaminedBlockIndex(null);
      setCandidateBlockIndices([]);
      return true;
    }
    log(`Worst-Fit: Allocation failed for P${process.id} (Size: ${process.size}). No suitable free block.`);
    setCandidateBlockIndices([]);
    return false;
  }, [log]);

  const deallocateMemory = useCallback((processIdToRemove: number) => {
    const processIndex = processes.findIndex(p => p.id === processIdToRemove);
    if (processIndex === -1) {
      log(`Error: Process P${processIdToRemove} not found for deallocation.`);
      showAlert('Deallocation Error', `Process P${processIdToRemove} not found.`);
      return;
    }
    const processToRemove = processes[processIndex];
    if (processToRemove.allocatedBlockIndex === null ||
      processToRemove.allocatedBlockIndex < 0 ||
      processToRemove.allocatedBlockIndex >= memoryBlocksRef.current.length ||
      memoryBlocksRef.current[processToRemove.allocatedBlockIndex].processId !== processIdToRemove) {
      log(`Error: Process P${processIdToRemove} has inconsistent allocation data. Index: ${processToRemove.allocatedBlockIndex}. Block: ${memoryBlocksRef.current[processToRemove.allocatedBlockIndex] ? JSON.stringify(memoryBlocksRef.current[processToRemove.allocatedBlockIndex]) : 'N/A'}`);
      showAlert('Deallocation Error', `Inconsistent allocation data for P${processIdToRemove}. Removing process entry.`);
      setProcesses(prev => prev.filter(p => p.id !== processIdToRemove));
      return;
    }
    const blockIndex = processToRemove.allocatedBlockIndex;
    log(`Deallocating P${processIdToRemove} from block ${blockIndex}.`);
    let updatedBlocks = [...memoryBlocksRef.current];
    updatedBlocks[blockIndex] = { ...updatedBlocks[blockIndex], status: BLOCK_STATUS.FREE, processId: null };

    let merged = true;
    while (merged) {
      merged = false;
      const mergedIteration: Block[] = [];
      let i = 0;
      while (i < updatedBlocks.length) {
        let current = updatedBlocks[i];
        if (i + 1 < updatedBlocks.length && current.status === BLOCK_STATUS.FREE && updatedBlocks[i + 1].status === BLOCK_STATUS.FREE) {
          const next = updatedBlocks[i + 1];
          log(`Merging free block (orig idx ${i}, size ${current.size}) with next (orig idx ${i + 1}, size ${next.size}). New index ${mergedIteration.length}.`);
          mergedIteration.push({ ...current, size: current.size + next.size });

          const originalIndexOfSecondMergedBlock = i + 1;
          setProcesses(prevProcs => prevProcs.map(p => {
            if (p.allocatedBlockIndex !== null && p.allocatedBlockIndex > originalIndexOfSecondMergedBlock) {
              return { ...p, allocatedBlockIndex: p.allocatedBlockIndex - 1 };
            }
            return p;
          }));
          i += 2;
          merged = true;
        } else {
          mergedIteration.push(current);
          i += 1;
        }
      }
      updatedBlocks = mergedIteration;
    }

    let currentAddress = 0;
    updatedBlocks = updatedBlocks.map(block => {
      const newBlock = { ...block, start: currentAddress };
      currentAddress += block.size;
      return newBlock;
    });

    setMemoryBlocks(updatedBlocks);
    setProcesses(prev => prev.filter(p => p.id !== processIdToRemove));
    log(`Deallocation complete for P${processIdToRemove}. Memory layout updated.`);
  }, [processes, log, showAlert]);

  // --- Event Handlers ---
  const handleAddProcess = useCallback(async () => {
    const size = parseInt(newProcessSize, 10);
    if (isNaN(size) || size <= 0) {
      showAlert('Invalid Input', 'Please enter a valid positive number for process size.');
      log(`Invalid process size input: ${newProcessSize}`);
      return;
    }
    if (size > memorySize) {
      showAlert('Invalid Input', `Process size (${size}) cannot exceed total memory (${memorySize}).`);
      log(`Process size ${size} exceeds total memory ${memorySize}.`);
      return;
    }
    setIsAnimating(true);
    setExaminedBlockIndex(null);
    setCandidateBlockIndices([]);
    const newProcessData = { id: nextProcessId, size: size, allocatedBlockIndex: null };
    const currentStrategy = dynamicStrategy || DYNAMIC_STRATEGIES.FIRST_FIT;
    log(`Attempting to add P${newProcessData.id} (Size: ${size}) using ${currentStrategy.replace('_', '-').toUpperCase()} strategy.`);
    let allocated = false;
    try {
      if (selectedTechnique === MEMORY_MANAGEMENT_TYPES.DYNAMIC_ALLOCATION) {
        switch (currentStrategy) {
          case DYNAMIC_STRATEGIES.FIRST_FIT:
            allocated = await allocateFirstFit(newProcessData);
            break;
          case DYNAMIC_STRATEGIES.BEST_FIT:
            allocated = await allocateBestFit(newProcessData);
            break;
          case DYNAMIC_STRATEGIES.WORST_FIT:
            allocated = await allocateWorstFit(newProcessData);
            break;
          default:
            log(`Unknown strategy: ${currentStrategy}`);
            showAlert('Error', `Unknown strategy: ${currentStrategy}`);
        }
      } else {
        log(`Technique ${selectedTechnique} not implemented.`);
        showAlert('Not Implemented', `Technique '${selectedTechnique}' not implemented.`);
      }
    } catch (error) {
      log(`Error during allocation: ${error instanceof Error ? error.message : String(error)}`);
      showAlert('Error', `Allocation error: ${error instanceof Error ? error.message : String(error)}`);
    } finally {
      setIsAnimating(false);
      setExaminedBlockIndex(null);
      setCandidateBlockIndices([]);
    }

    if (allocated) {
      setNextProcessId(prev => prev + 1);
      setNewProcessSize('');
    } else if (!alertDialog.open) {
      showAlert('Allocation Failed', `Failed to allocate P${newProcessData.id} (Size: ${size}) using ${currentStrategy.replace('_', '-').toUpperCase()}.`);
    }
  }, [newProcessSize, nextProcessId, dynamicStrategy, selectedTechnique, memorySize, log, showAlert, allocateFirstFit, allocateBestFit, allocateWorstFit, alertDialog.open]);

  const handleRemoveProcess = useCallback((processId: number) => {
    if (isAnimating) {
      showAlert('Busy', 'Animation in progress.');
      return;
    }
    log(`User initiated removal of P${processId}.`);
    deallocateMemory(processId);
  }, [deallocateMemory, log, isAnimating, showAlert]);

  const handleReset = useCallback(() => {
    if (isAnimating) {
      showAlert('Busy', 'Animation in progress.');
      return;
    }
    log('User initiated simulation reset.');
    resetSimulation(memorySize);
  }, [resetSimulation, memorySize, isAnimating, showAlert, log]);

  const handleTechniqueChange = (value: string) => {
    if (isAnimating) {
      showAlert('Busy', 'Animation in progress.');
      return;
    }
    setSelectedTechnique(value as MemoryManagementType);
    log(`Technique changed to: ${value}. Resetting.`);
    showAlert('Technique Changed', `Switched to ${value}. Simulation reset.`);
    resetSimulation(memorySize);
  };

  const handleStrategyChange = (value: string) => {
    if (isAnimating) {
      showAlert('Busy', 'Animation in progress.');
      return;
    }
    setDynamicStrategy(value as DynamicStrategy);
    log(`Strategy changed to: ${value}. Resetting.`);
    showAlert('Strategy Changed', `Switched to ${value}. Simulation reset.`);
    resetSimulation(memorySize);
  };

  // --- Calculations for Display ---
  const memoryStats = useMemo(() => {
    const allocatedBlocks = memoryBlocks.filter(block => block.status === BLOCK_STATUS.ALLOCATED);
    const freeBlocks = memoryBlocks.filter(block => block.status === BLOCK_STATUS.FREE);
    const totalAllocated = allocatedBlocks.reduce((sum, block) => sum + block.size, 0);
    const actualTotalFree = memorySize - totalAllocated;
    const utilization = memorySize > 0 ? (totalAllocated / memorySize) * 100 : 0;
    const largestFreeBlock = freeBlocks.reduce((max, block) => Math.max(max, block.size), 0);
    let fragmentationMetric = 0;
    if (actualTotalFree > 0 && freeBlocks.length > 1) {
      fragmentationMetric = (1 - (largestFreeBlock / actualTotalFree)) * 100;
    } else if (actualTotalFree > 0 && freeBlocks.length === 1 && largestFreeBlock < actualTotalFree) {
      fragmentationMetric = (1 - (largestFreeBlock / actualTotalFree)) * 100;
    }
    return {
      totalAllocated,
      totalFree: actualTotalFree,
      utilization: utilization.toFixed(2),
      largestFreeBlock,
      fragmentationMetric: fragmentationMetric.toFixed(2),
      blockCount: memoryBlocks.length,
      allocatedBlockCount: allocatedBlocks.length,
      freeBlockCount: freeBlocks.length
    };
  }, [memoryBlocks, memorySize]);

  return (
    <div className="flex flex-col min-h-screen px-4 py-3 bg-gray-100 dark:bg-gray-800 dark:text-white transition-colors">
      <div className="absolute top-0 right-0 p-4">
        <Button variant="outline" size="icon" onClick={toggleTheme} aria-label="Toggle Dark Mode">
          {theme === 'dark' ? <SunIcon className="h-5 w-5" /> : <MoonIcon className="h-5 w-5" />}
        </Button>
      </div>

      <AlertDialog title={alertDialog.title} description={alertDialog.description} open={alertDialog.open} onClose={closeAlert} theme={theme} />

      <h1 className="text-2xl font-bold mb-8 text-center text-blue-700 dark:text-blue-400">Memory Management Visualization</h1>

      <div className="flex flex-col md:flex-row gap-6 flex-grow">
        <aside className="w-full md:w-80 flex flex-col gap-4">
          <Card>
            <CardHeader><CardTitle>Configuration</CardTitle></CardHeader>
            <CardContent className="space-y-4">
              <div>
                <Label htmlFor="memory-size">Memory Size (Units)</Label>
                <div className="flex space-x-2">
                  <Input
                    id="memory-size"
                    type="number"
                    value={memorySize.toString()}
                    onChange={(e) => {
                      const newSize = parseInt(e.target.value, 10);
                      if (newSize > 0 && newSize <= 1000) {
                        setMemorySize(newSize);
                        resetSimulation(newSize);
                      }
                    }}
                    min="10"
                    max="1000"
                    disabled={isAnimating}
                  />
                </div>
              </div>
              <div>
                <Label htmlFor="technique-select">Technique</Label>
                <Select id="technique-select" value={selectedTechnique} onValueChange={handleTechniqueChange} disabled={isAnimating}>
                  <SelectItem value={MEMORY_MANAGEMENT_TYPES.DYNAMIC_ALLOCATION}>Dynamic Allocation</SelectItem>
                </Select>
              </div>
              {selectedTechnique === MEMORY_MANAGEMENT_TYPES.DYNAMIC_ALLOCATION && (
                <div>
                  <Label htmlFor="strategy-select">Strategy</Label>
                  <Select id="strategy-select" value={dynamicStrategy} onValueChange={handleStrategyChange} disabled={isAnimating}>
                    <SelectItem value={DYNAMIC_STRATEGIES.FIRST_FIT}>First-Fit</SelectItem>
                    <SelectItem value={DYNAMIC_STRATEGIES.BEST_FIT}>Best-Fit</SelectItem>
                    <SelectItem value={DYNAMIC_STRATEGIES.WORST_FIT}>Worst-Fit</SelectItem>
                  </Select>
                </div>
              )}
              <div> 
                <Button variant="outline" className="w-full" onClick={handleReset} disabled={isAnimating}> 
                  Reset Simulation 
                </Button> 
              </div>
            </CardContent>
          </Card>

          <Card>
            <CardHeader><CardTitle>Process Management</CardTitle></CardHeader>
            <CardContent className="space-y-4">
              <div className="flex space-x-2">
                <Input 
                  type="number" 
                  value={newProcessSize} 
                  onChange={(e) => setNewProcessSize(e.target.value)} 
                  placeholder="Process Size" 
                  min="1" 
                  disabled={isAnimating}
                />
                <Button 
                  onClick={handleAddProcess} 
                  disabled={!newProcessSize || selectedTechnique !== MEMORY_MANAGEMENT_TYPES.DYNAMIC_ALLOCATION || isAnimating}
                >
                  {isAnimating ? 'Running...' : 'Add Process'}
                </Button>
              </div>
              <Label className="!mb-1">Process List ({processes.length})</Label>
              <div className="max-h-60 overflow-y-auto space-y-2 border rounded p-3 bg-gray-50 dark:bg-gray-700/30 border-gray-200 dark:border-gray-600 custom-scrollbar">
                {processes.length === 0 && <p className="text-xs text-gray-500 dark:text-gray-400 text-center py-4">No active processes.</p>}
                {processes.sort((a,b) => a.id - b.id).map(proc => (
                  <div key={proc.id} className="flex justify-between items-center text-sm bg-white dark:bg-gray-700 p-2 rounded shadow-sm border border-gray-200 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600/70">
                    <span className="truncate pr-2 dark:text-gray-200">ID: {proc.id} (Size: {proc.size}) {proc.allocatedBlockIndex !== null ? ` @ Block ${proc.allocatedBlockIndex}` : '(Unallocated)'}</span>
                    <Button variant="destructive" size="sm" onClick={() => handleRemoveProcess(proc.id)} className="px-2 py-1 text-xs flex-shrink-0" disabled={isAnimating || proc.allocatedBlockIndex === null}>Remove</Button>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>
          <div className="flex-grow"></div>
        </aside>

        <main className="flex-1 flex flex-col p-4 overflow-hidden">
          <Card className="flex-1 flex flex-col mb-4 overflow-hidden">
            <CardHeader> <CardTitle> Memory Visualization ({dynamicStrategy ? dynamicStrategy.replace(/_/g, '-').toUpperCase() : 'N/A'}) </CardTitle> </CardHeader>
            <CardContent className="flex-grow flex flex-col overflow-hidden">
              <div className="bg-gray-200 dark:bg-gray-700/50 h-48 md:h-64 rounded border border-gray-300 dark:border-gray-600 mb-4 overflow-hidden shadow-inner">
                <MemoryVisualization
                  blocks={memoryBlocks}
                  totalSize={memorySize}
                  examinedIndex={examinedBlockIndex}
                  candidateIndices={candidateBlockIndices}
                  currentTheme={theme}
                />
              </div>
              <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-xs sm:text-sm">
                <MetricCard title="Utilization" value={`${memoryStats.utilization}%`} baseBgColor="blue" theme={theme}/>
                <MetricCard title="Allocated" value={`${memoryStats.totalAllocated} Units`} baseBgColor="green" theme={theme}/>
                <MetricCard title="Free" value={`${memoryStats.totalFree} Units`} baseBgColor="yellow" theme={theme}/>
                <MetricCard title="Fragmentation" value={`${memoryStats.fragmentationMetric}%`} subValue={`(Largest Free: ${memoryStats.largestFreeBlock})`} baseBgColor="red" theme={theme}/>
                <MetricCard title="Blocks" value={`${memoryStats.blockCount} (${memoryStats.freeBlockCount} Free)`} baseBgColor="indigo" theme={theme}/>
              </div>
            </CardContent>
          </Card>

          <Card className="h-1/3 flex flex-col">
            <CardHeader><CardTitle>Simulation Log</CardTitle></CardHeader>
            <CardContent className="flex-grow overflow-y-auto custom-scrollbar">
              <pre className="text-xs font-mono whitespace-pre-wrap leading-relaxed dark:text-gray-300">
                {logMessages.join('\n')}
              </pre>
            </CardContent>
          </Card>
        </main>
      </div>
    </div>
  );
}

export default App;
